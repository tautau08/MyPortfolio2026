# Copy to .env.local (never committed) and fill in. On Vercel, add these under
# Project → Settings → Environment Variables instead.

# Resend API key for the contact form: https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where messages go (defaults to profile.links.email).
CONTACT_TO=

# Optional. Sender shown in your inbox. Resend's shared address works without a domain,
# but it can only deliver to the email you signed up to Resend with.
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Optional. Your domain, for link previews and the sitemap (e.g. https://tauhid.dev).
# On Vercel the production URL is detected automatically.
NEXT_PUBLIC_SITE_URL=
